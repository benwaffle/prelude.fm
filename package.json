{
  "name": "prelude-fm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:staged": "lint-staged",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "queue:drain": "tsx scripts/drain-match-queue.ts",
    "metadata:validate": "tsx scripts/validate-metadata.ts",
    "metadata:accounting": "tsx scripts/mb-accounting.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate-db.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "mb:ingest": "tsx scripts/mb-ingest.ts",
    "mb:bot": "tsx scripts/mb-bot.ts",
    "mb:authorise": "tsx scripts/mb-authorise.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "@spotify/web-api-ts-sdk": "^1.2.0",
    "better-auth": "^1.4.7",
    "drizzle-orm": "^0.45.1",
    "next": "16.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@next/env": "16.1.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/spotify-web-playback-sdk": "^0.1.19",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9",
    "eslint-config-next": "16.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{css,json,jsonc,md,mdx,svg,yaml,yml}": "prettier --write"
  }
}
